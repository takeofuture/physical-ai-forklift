<?xml version="1.0" ?>
<sdf version="1.10">
  
<model name="forklift_simple">
  <pose>0 0 0 0 0 0</pose>
  <static>false</static>
  <self_collide>false</self_collide>
  <allow_auto_disable>false</allow_auto_disable>


    <link name="base_link">
      <pose>0.0000 0.0000 0.2000 0.0000 0.0000 0.0000</pose>

      <velocity_decay>
        <linear>0.1</linear>
        <angular>2.5</angular>
      </velocity_decay>

      <inertial>
        <mass>400.000000</mass>
        <inertia>
          <ixx>36.333333</ixx>
          <iyy>68.333333</iyy>
          <izz>98.666667</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <box><size>1.4000 1.0000 0.3000</size></box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>1.2</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <box><size>1.4000 1.0000 0.3000</size></box>
        </geometry>
        <material>
          <ambient>0.95 0.82 0.2 1.0</ambient>
          <diffuse>0.95 0.82 0.2 1.0</diffuse>
        </material>
      </visual>

      <sensor name="base_link_contact" type="contact">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <contact>
          <collision>collision</collision>
        </contact>
      </sensor>

    </link>
    
    <link name="left_wheel_link">
      <pose>-0.1000 0.4000 0.1400 1.5708 0 0</pose>
      <inertial>
        <mass>8.000000</mass>
        <inertia>
          <ixx>0.043467</ixx>
          <iyy>0.078400</iyy>
          <izz>0.043467</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.1400</radius>
            <length>0.0800</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.8</mu>
              <mu2>1.8</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.1400</radius>
            <length>0.0800</length>
          </cylinder>
        </geometry>
      </visual>
    </link>
    
    <link name="right_wheel_link">
      <pose>-0.1000 -0.4000 0.1400 1.5708 0 0</pose>
      <inertial>
        <mass>8.000000</mass>
        <inertia>
          <ixx>0.043467</ixx>
          <iyy>0.078400</iyy>
          <izz>0.043467</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.1400</radius>
            <length>0.0800</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.8</mu>
              <mu2>1.8</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.1400</radius>
            <length>0.0800</length>
          </cylinder>
        </geometry>
      </visual>
    </link>
    
    <link name="caster_link">
      <pose>0.4800 0.0000 0.0800 0 0 0</pose>
      <inertial>
        <mass>3.000000</mass>
        <inertia>
          <ixx>0.007680</ixx>
          <iyy>0.007680</iyy>
          <izz>0.007680</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <sphere><radius>0.0800</radius></sphere>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <sphere><radius>0.0800</radius></sphere>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1.0</ambient>
          <diffuse>0.3 0.3 0.3 1.0</diffuse>
        </material>
      </visual>
    </link>
    
    <link name="lift_guide_link">
      <pose>0.3500 0.0000 0.4500 0.0000 0.0000 0.0000</pose>

      <inertial>
        <mass>20.000000</mass>
        <inertia>
          <ixx>1.016667</ixx>
          <iyy>0.624000</iyy>
          <izz>0.440667</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <box><size>0.1200 0.5000 0.6000</size></box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>1.2</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <box><size>0.1200 0.5000 0.6000</size></box>
        </geometry>
        <material>
          <ambient>0.35 0.35 0.38 1.0</ambient>
          <diffuse>0.35 0.35 0.38 1.0</diffuse>
        </material>
      </visual>

    </link>
    
    <link name="fork_carriage_link">
      <pose relative_to="lift_joint">0.0000 0.0000 0.2000 0.0000 0.0000 0.0000</pose>

      <inertial>
        <mass>4.000000</mass>
        <inertia>
          <ixx>0.168133</ixx>
          <iyy>0.008133</iyy>
          <izz>0.166667</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <box><size>0.1000 0.7000 0.1200</size></box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>1.2</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <box><size>0.1000 0.7000 0.1200</size></box>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.85 1.0</ambient>
          <diffuse>0.2 0.2 0.85 1.0</diffuse>
        </material>
      </visual>

      <sensor name="fork_carriage_link_contact" type="contact">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <contact>
          <collision>collision</collision>
        </contact>
      </sensor>

    </link>
    
    <link name="left_fork_link">
      <pose relative_to="fork_carriage_link">0.5500 0.1800 -0.0600 0.0000 0.0000 0.0000</pose>

      <inertial>
        <mass>1.000000</mass>
        <inertia>
          <ixx>0.000667</ixx>
          <iyy>0.100967</iyy>
          <izz>0.101367</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <box><size>1.1000 0.0800 0.0400</size></box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>1.2</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <box><size>1.1000 0.0800 0.0400</size></box>
        </geometry>
        <material>
          <ambient>0.45 0.45 0.48 1.0</ambient>
          <diffuse>0.45 0.45 0.48 1.0</diffuse>
        </material>
      </visual>

      <sensor name="left_fork_link_contact" type="contact">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <contact>
          <collision>collision</collision>
        </contact>
      </sensor>

    </link>
    
    <link name="right_fork_link">
      <pose relative_to="fork_carriage_link">0.5500 -0.1800 -0.0600 0.0000 0.0000 0.0000</pose>

      <inertial>
        <mass>1.000000</mass>
        <inertia>
          <ixx>0.000667</ixx>
          <iyy>0.100967</iyy>
          <izz>0.101367</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <box><size>1.1000 0.0800 0.0400</size></box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>1.2</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <box><size>1.1000 0.0800 0.0400</size></box>
        </geometry>
        <material>
          <ambient>0.45 0.45 0.48 1.0</ambient>
          <diffuse>0.45 0.45 0.48 1.0</diffuse>
        </material>
      </visual>

      <sensor name="right_fork_link_contact" type="contact">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <contact>
          <collision>collision</collision>
        </contact>
      </sensor>

    </link>
    


    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel_link</child>
      <axis>
        <xyz expressed_in="base_link">0 1 0</xyz>
        <limit><lower>-1000000</lower><upper>1000000</upper><effort>300</effort><velocity>50</velocity></limit>
        <dynamics><damping>2.0</damping><friction>1.0</friction></dynamics>
      </axis>
    </joint>

    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel_link</child>
      <axis>
        <xyz expressed_in="base_link">0 1 0</xyz>
        <limit><lower>-1000000</lower><upper>1000000</upper><effort>300</effort><velocity>50</velocity></limit>
        <dynamics><damping>2.0</damping><friction>1.0</friction></dynamics>
      </axis>
    </joint>

    <joint name="caster_joint" type="fixed">
      <parent>base_link</parent>
      <child>caster_link</child>
    </joint>

    <joint name="lift_guide_joint" type="fixed">
      <parent>base_link</parent>
      <child>lift_guide_link</child>
    </joint>

    <joint name="lift_joint" type="prismatic">
      <pose relative_to="lift_guide_link">0 0 0 0 0 0</pose>
      <parent>lift_guide_link</parent>
      <child>fork_carriage_link</child>
      <axis>
        <xyz expressed_in="lift_guide_link">0 0 1</xyz>
        <limit>
          <lower>0.000</lower>
          <upper>8.400</upper>
          <effort>4000</effort>
          <velocity>0.8</velocity>
        </limit>
        <!-- Stronger damping/friction keeps the carriage from bouncing or drifting when driving. -->
        <dynamics><damping>18.0</damping><friction>1.5</friction></dynamics>
      </axis>
    </joint>

    <joint name="left_fork_joint" type="fixed">
      <parent>fork_carriage_link</parent>
      <child>left_fork_link</child>
    </joint>

    <joint name="right_fork_joint" type="fixed">
      <parent>fork_carriage_link</parent>
      <child>right_fork_link</child>
    </joint>


  <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
    <left_joint>left_wheel_joint</left_joint>
    <right_joint>right_wheel_joint</right_joint>
    <wheel_separation>0.8000</wheel_separation>
    <wheel_radius>0.1400</wheel_radius>
    <topic>/model/forklift_simple/cmd_vel</topic>
    <odom_topic>/model/forklift_simple/odometry</odom_topic>
    <tf_topic>/model/forklift_simple/tf</tf_topic>
    <frame_id>odom</frame_id>
    <child_frame_id>base_link</child_frame_id>
  </plugin>

  <!--
    Lift controller.
    This uses force commands, not velocity commands.
    Positive force raises the fork carriage; negative force lowers it.
    Gravity is enabled on the carriage/forks, so 0.0 force means no lift actuation;
    the lower joint limit and joint damping/friction keep the fork from floating upward.
  -->
  <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
    <joint_name>lift_joint</joint_name>
    <topic>/model/forklift_simple/lift_force_cmd</topic>
    <use_force_commands>true</use_force_commands>
  </plugin>

  <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
    <joint_name>lift_joint</joint_name>
  </plugin>
</model>

</sdf>
